<?xml version="1.0" encoding="utf-8"?>
<!--
    Desde Android 9 el tráfico HTTP sin cifrar está bloqueado por defecto.
    Se permite solo hacia 10.0.2.2, la dirección con la que el emulador llega al
    localhost de la máquina donde corre Servicio-turnos. Cualquier otro host sigue
    exigiendo HTTPS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
